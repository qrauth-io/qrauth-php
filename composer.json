{
  "name": "qrauth/qrauth-php",
  "description": "QRAuth PHP SDK",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "QRAuth",
      "email": "info@qrauth.io"
    }
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "QRAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "QRAuth\\Tests\\": "tests/"
    }
  },
  "keywords": [
    "qrauth",
    "qr",
    "authentication",
    "verification"
  ],
  "homepage": "https://github.com/qrauth-io/sdk-php",
  "support": {
    "docs": "https://docs.qrauth.io",
    "issues": "https://github.com/qrauth-io/sdk-php/issues"
  }
}
