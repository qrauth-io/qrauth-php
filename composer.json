{
  "name": "qrauth/qrauth-php",
  "description": "QRAuth PHP SDK — passwordless QR authentication and signed-QR verification.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "QRAuth",
      "email": "info@qrauth.io"
    }
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "QRAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "QRAuth\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse"
  },
  "keywords": [
    "qrauth",
    "qr",
    "authentication",
    "passwordless",
    "verification",
    "passkey",
    "webauthn"
  ],
  "homepage": "https://github.com/qrauth-io/qrauth-php",
  "support": {
    "docs": "https://docs.qrauth.io",
    "issues": "https://github.com/qrauth-io/qrauth-php/issues"
  }
}
